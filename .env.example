FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-in-production-use-a-real-secret
DATABASE_URL=sqlite:///instance/planejaenem.db
PORT=5000
FLASK_DEBUG=0
RATELIMIT_STORAGE_URI=memory://

# AI Gateway (PlanejaENEM 5.0)
AI_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_TIMEOUT=30
AI_MAX_RETRIES=2
AI_MAX_TOKENS=2048
